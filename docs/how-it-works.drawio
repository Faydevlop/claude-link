<mxfile host="drawio"><diagram id="claude-link" name="How Claude Link works"><mxGraphModel dx="1400" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="net" value="Internet" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fillColor=#eff6ff;strokeColor=#2563eb;dashed=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="560" height="130" as="geometry"/></mxCell><mxCell id="anthropic" value="&lt;b&gt;Anthropic&lt;/b&gt;&lt;br&gt;Claude models" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="570" y="50" width="260" height="90" as="geometry"/></mxCell><mxCell id="lan" value='Office Wi-Fi (local network) &amp;nbsp;·&amp;nbsp; &lt;span style="font-weight:normal"&gt;all Claude Link traffic stays inside this box&lt;/span&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=15;fontStyle=1;fillColor=#fafaf9;strokeColor=#a8a29e;dashed=1;fontColor=#44403c;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1360" height="560" as="geometry"/></mxCell><mxCell id="lead" value="Team lead's computer (Mac)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#57534e;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="520" height="480" as="geometry"/></mxCell><mxCell id="lchat" value="&lt;b&gt;Claude Link window&lt;/b&gt;&lt;br&gt;Status · Chat · Tasks&lt;br&gt;Members · My Claude" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="200" height="110" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Team server&lt;/b&gt;&lt;br&gt;port 4545, LAN only&lt;br&gt;chat history &amp;amp; status saved&lt;br&gt;on this computer (hub.db)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="200" height="110" as="geometry"/></mxCell><mxCell id="lcc" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;the lead's own login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="440" width="200" height="100" as="geometry"/></mxCell><mxCell id="lagent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;answers questions&lt;br&gt;asks before any change" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="200" height="100" as="geometry"/></mxCell><mxCell id="lproj" value="Project folders (git)" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="tm" value="Each teammate's computer (Windows / Mac)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#ffffff;strokeColor=#57534e;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="240" width="520" height="480" as="geometry"/></mxCell><mxCell id="tchat" value="&lt;b&gt;Claude Link window&lt;/b&gt;&lt;br&gt;Chat · Requests&lt;br&gt;Settings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;" vertex="1" parent="1"><mxGeometry x="860" y="290" width="200" height="110" as="geometry"/></mxCell><mxCell id="tmy" value="&lt;b&gt;My Claude&lt;/b&gt;&lt;br&gt;chat with your own Claude&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;" vertex="1" parent="1"><mxGeometry x="1120" y="290" width="200" height="110" as="geometry"/></mxCell><mxCell id="tagent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;answers questions&lt;br&gt;asks before any change" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#fbe3d9;strokeColor=#d97757;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="200" height="100" as="geometry"/></mxCell><mxCell id="tcc" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;this person's own login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="200" height="100" as="geometry"/></mxCell><mxCell id="tproj" value="Project folders (git)" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="mid" value="&lt;b&gt;Over office Wi-Fi only&lt;/b&gt;&lt;br&gt;HTTP + WebSocket, port 4545&lt;br&gt;&lt;br&gt;The app finds the team&lt;br&gt;on the Wi-Fi by itself (mDNS)&lt;br&gt;and the lead approves each join" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#57534e;" vertex="1" parent="1"><mxGeometry x="585" y="560" width="230" height="150" as="geometry"/></mxCell><mxCell id="e1" value="chat, status, requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;strokeColor=#d97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.35;entryX=1;entryY=0.35;" edge="1" parent="1" source="tchat" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="questions &amp;amp; answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;strokeColor=#d97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="tagent" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;strokeColor=#d97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lchat" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;strokeColor=#d97757;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="lagent" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#57534e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="lagent" target="lcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="reads code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#57534e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lcc" target="lproj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#57534e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tagent" target="tcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#57534e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tmy" target="tcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="reads code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#57534e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tcc" target="tproj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;dashed=1;dashPattern=8 4;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontColor=#1d4ed8;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lcc" target="anthropic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="490"/><mxPoint x="35" y="95"/></Array></mxGeometry></mxCell><mxCell id="n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;startArrow=classic;dashed=1;dashPattern=8 4;strokeColor=#2563eb;strokeWidth=2;fontSize=11;fontColor=#1d4ed8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tcc" target="anthropic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="490"/><mxPoint x="1365" y="95"/></Array></mxGeometry></mxCell><mxCell id="nl1" value="Claude Code only (HTTPS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="60" y="62" width="330" height="24" as="geometry"/></mxCell><mxCell id="nl2" value="Claude Code only (HTTPS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1010" y="62" width="330" height="24" as="geometry"/></mxCell><mxCell id="legend" value='&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;font color="#d97757"&gt;━━&lt;/font&gt; Claude Link: local Wi-Fi only, never the internet&lt;br&gt;&lt;font color="#2563eb"&gt;╍╍&lt;/font&gt; Internet: only Claude Code talking to Anthropic,&lt;br&gt;exactly as when you use Claude Code on your own&lt;br&gt;&lt;font color="#57534e"&gt;━━&lt;/font&gt; Inside one computer' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#44403c;" vertex="1" parent="1"><mxGeometry x="20" y="775" width="520" height="125" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;Example: &quot;ask the backend Claude what /orders returns&quot;&lt;/b&gt;&lt;br&gt;1. A teammate asks in Chat or My Claude. &amp;nbsp;2. The question goes to the team server over Wi-Fi.&lt;br&gt;3. The server passes it to the backend developer's agent. &amp;nbsp;4. Their Claude Code reads their code (read-only).&lt;br&gt;5. The answer travels back the same way and is saved in the chat. &amp;nbsp;A &lt;i&gt;fix&lt;/i&gt; waits for the owner's approval first.&lt;br&gt;&lt;b&gt;Claude Link is only a messenger between Claudes:&lt;/b&gt; it does not run a cloud server, collect data or open your PC to the internet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#44403c;" vertex="1" parent="1"><mxGeometry x="560" y="775" width="820" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>